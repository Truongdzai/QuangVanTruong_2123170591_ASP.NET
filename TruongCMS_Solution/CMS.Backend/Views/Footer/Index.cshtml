@*
    Ho ten: Quang Van Truong || MSV: 2123170591
    Quan ly FOOTER DONG: cot link + cau hinh site (mo ta, mang xa hoi, ban quyen)
*@
@model IEnumerable<CMS.Data.Entities.FooterLink>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Footer";
    var st = (Dictionary<string, string>)ViewBag.Settings;
    string S(string k) => st.TryGetValue(k, out var v) ? v : "";
}

<h4 class="mb-3"><i class="bi bi-layout-text-window-reverse"></i> QUẢN LÝ FOOTER ĐỘNG</h4>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"]   != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row g-4">
    @* Cau hinh chung *@
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white"><i class="bi bi-gear"></i> Cấu hình chung</div>
            <div class="card-body">
                <form asp-action="SaveSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả footer</label>
                        <textarea name="description" class="form-control" rows="3">@S("footer.description")</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Dòng bản quyền</label>
                        <input name="copyright" class="form-control" value="@S("footer.copyright")" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold">Facebook URL</label>
                        <input name="facebook" class="form-control" value="@S("social.facebook")" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-bold">Messenger URL</label>
                        <input name="messenger" class="form-control" value="@S("social.messenger")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Zalo URL</label>
                        <input name="zalo" class="form-control" value="@S("social.zalo")" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-save"></i> Lưu cấu hình</button>
                </form>
            </div>
        </div>
    </div>

    @* Cac cot link *@
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-warning"><i class="bi bi-plus-circle"></i> Thêm liên kết</div>
            <div class="card-body">
                <form asp-action="AddLink" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label small">Cột</label>
                        <input name="groupHeading" class="form-control" placeholder="CÔNG TY" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Nhãn</label>
                        <input name="label" class="form-control" placeholder="Giới thiệu" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Đường dẫn</label>
                        <input name="url" class="form-control" placeholder="/about" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Thứ tự</label>
                        <input name="sortOrder" type="number" value="0" class="form-control" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-warning w-100"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white"><i class="bi bi-list"></i> Liên kết hiện có (@Model.Count())</div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr><th>Cột</th><th>Nhãn</th><th>Đường dẫn</th><th style="width:60px">TT</th><th style="width:50px">Bật</th><th style="width:90px"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model)
                        {
                            string fid = $"frm-footer-{l.Id}";
                            <tr>
                                <td><input name="groupHeading" form="@fid" value="@l.GroupHeading" class="form-control form-control-sm" /></td>
                                <td><input name="label" form="@fid" value="@l.Label" class="form-control form-control-sm" /></td>
                                <td><input name="url" form="@fid" value="@l.Url" class="form-control form-control-sm" /></td>
                                <td><input name="sortOrder" form="@fid" type="number" value="@l.SortOrder" class="form-control form-control-sm" /></td>
                                <td class="text-center">
                                    <input name="isActive" form="@fid" type="checkbox" value="true" class="form-check-input" checked="@(l.IsActive ? "checked" : null)" />
                                    <input type="hidden" name="isActive" form="@fid" value="false" />
                                </td>
                                <td class="text-center">
                                    <form asp-action="UpdateLink" method="post" id="@fid" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary" title="Lưu"><i class="bi bi-save"></i></button>
                                    </form>
                                    <form asp-action="DeleteLink" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa liên kết này?')"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
