@model CMS.Data.Entities.DiscountCode

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua ma giam gia"; }

<div class="card shadow" style="max-width:620px">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> SUA MA GIAM GIA #@Model.Id</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-7 mb-3">
                    <label class="form-label fw-bold">Ma: <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control text-uppercase" required />
                    <span class="text-danger">@Html.ValidationMessage("Code")</span>
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label fw-bold">Giam (%): <span class="text-danger">*</span></label>
                    <input asp-for="Percent" type="number" min="1" max="100" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mo ta:</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Han su dung:</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">So luot toi da (0 = vo han):</label>
                    <input asp-for="MaxUses" type="number" min="0" class="form-control" />
                </div>
            </div>

            @* Nang cap theo bao cao nghien cuu: dieu kien ap ma (test case 7-8) *@
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Don hang toi thieu (0 = khong yeu cau):</label>
                    <input asp-for="MinOrderAmount" type="number" min="0" step="0.01" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">So lan moi khach (0 = vo han):</label>
                    <input asp-for="MaxUsesPerCustomer" type="number" min="0" class="form-control" />
                </div>
            </div>

            <p class="text-muted small">
                Da dung: <strong>@Model.UsedCount</strong> luot
                @if (Model.CustomerId.HasValue)
                {
                    <span> — Ma ca nhan cua khach hang #@Model.CustomerId</span>
                }
            </p>

            <div class="form-check form-switch mb-3">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label class="form-check-label fw-bold" asp-for="IsActive">Dang kich hoat</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Luu thay doi
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lai
                </a>
            </div>
        </form>
    </div>
</div>
