@model CMS.Data.Entities.Banner

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua banner"; }

<div class="card shadow" style="max-width:760px">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> SUA BANNER #@Model.Id</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Tieu de: <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mo ta ngan:</label>
                <textarea asp-for="Subtitle" class="form-control" rows="2"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Thay anh moi (file):</label>
                    <input type="file" name="uploadImage" class="form-control" accept="image/*"
                           onchange="xemTruocAnh(this)" />
                    <div class="form-text">Bo trong = giu anh hien tai.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">HOAC dan link anh:</label>
                    <input asp-for="ImageUrl" class="form-control"
                           oninput="document.getElementById('anhXemTruoc').src = this.value" />
                </div>
            </div>

            <img id="anhXemTruoc" src="@Model.ImageUrl"
                 class="rounded border mb-3" style="height:160px;object-fit:cover;width:100%"
                 onerror="this.src='/images/no-image.svg'" />

            <div class="row">
                <div class="col-md-5 mb-3">
                    <label class="form-label fw-bold">Link khi bam nut:</label>
                    <input asp-for="LinkUrl" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Chu tren nut:</label>
                    <input asp-for="ButtonText" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-bold">Thu tu:</label>
                    <input asp-for="SortOrder" type="number" class="form-control" />
                </div>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label class="form-check-label fw-bold" asp-for="IsActive">Hien thi tren trang chu</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Luu thay doi
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lai
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function xemTruocAnh(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('anhXemTruoc').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
}
