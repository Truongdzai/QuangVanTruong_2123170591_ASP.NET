@model IEnumerable<CMS.Data.Entities.Banner>

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Quan ly Banner"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-images"></i> QUAN LY BANNER TRANG CHU</h4>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Them banner moi
    </a>
</div>

<div class="alert alert-secondary small">
    <i class="bi bi-info-circle"></i> Banner DANG BAT se hien thanh slide dau tien tren HeroSlider
    cua trang chu ReactJS (sap theo cot Thu tu).
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-bordered mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width:55px">ID</th>
                    <th style="width:150px">Anh</th>
                    <th>Tieu de / Mo ta</th>
                    <th style="width:150px">Link</th>
                    <th style="width:75px" class="text-center">Thu tu</th>
                    <th style="width:100px" class="text-center">Trang thai</th>
                    <th style="width:175px" class="text-center">Thao tac</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsActive ? "" : "table-secondary")">
                        <td class="text-muted">@item.Id</td>
                        <td>
                            <img src="@item.ImageUrl"
                                 style="width:130px;height:60px;object-fit:cover;border-radius:6px"
                                 onerror="this.src='/images/no-image.svg'" />
                        </td>
                        <td>
                            <strong>@item.Title</strong>
                            <div class="text-muted small text-truncate" style="max-width:340px">@item.Subtitle</div>
                        </td>
                        <td class="small text-truncate" style="max-width:150px">@item.LinkUrl</td>
                        <td class="text-center">@item.SortOrder</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <a asp-action="ToggleActive" asp-route-id="@item.Id" class="badge bg-success text-decoration-none">Dang bat</a>
                            }
                            else
                            {
                                <a asp-action="ToggleActive" asp-route-id="@item.Id" class="badge bg-secondary text-decoration-none">Dang tat</a>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil"></i> Sua
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                               onclick="return confirm('Xoa banner [@item.Title]?')">
                                <i class="bi bi-trash"></i> Xoa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted small">Tong cong: @Model.Count() banner</div>
</div>
