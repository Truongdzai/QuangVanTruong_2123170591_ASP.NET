@model IEnumerable<CMS.Data.Entities.Product>

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Quan ly San pham"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-box-seam"></i> QUAN LY SAN PHAM</h4>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Them san pham moi
    </a>
</div>

@* Thanh TIM KIEM + LOC DANH MUC (GET, giu lai gia tri da nhap) *@
<form method="get" asp-action="Index" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small mb-1">Tìm theo tên / mô tả</label>
            <input type="text" name="search" value="@(ViewBag.Search as string)"
                   class="form-control" placeholder="Nhập từ khóa..." />
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-1">Lọc theo danh mục</label>
            <select name="categoryId" class="form-select" asp-items="ViewBag.CategoryProductList">
                <option value="">-- Tất cả danh mục --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search"></i> Tìm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-bordered mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width:60px">ID</th>
                    <th style="width:70px">Anh</th>
                    <th>Ten san pham</th>
                    <th style="width:160px">Danh muc</th>
                    <th style="width:110px" class="text-end">Gia (VND)</th>
                    <th style="width:90px" class="text-center">Ton kho</th>
                    <th style="width:160px" class="text-center">Thao tac</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted">@item.Id</td>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.svg" : item.ImageUrl)"
                                 style="width:50px;height:50px;object-fit:cover;border-radius:4px"
                                 onerror="this.src='/images/no-image.svg'" />
                        </td>
                        <td class="fw-bold">@item.Name</td>
                        <td>
                            <span class="badge bg-secondary">@item.CategoryProduct?.Name</span>
                        </td>
                        <td class="text-end text-success fw-bold">
                            @item.Price.ToString("N0")
                        </td>
                        <td class="text-center">
                            @if (item.StockQuantity == 0)
                            {
                                <span class="badge bg-danger">Het hang</span>
                            }
                            else if (item.StockQuantity < 10)
                            {
                                <span class="badge bg-warning text-dark">@item.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@item.StockQuantity</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-controller="Variant" asp-action="Manage" asp-route-id="@item.Id"
                               class="btn btn-sm btn-info me-1" title="Bien the SKU (Mau × Size)">
                                <i class="bi bi-boxes"></i> SKU
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil"></i> Sua
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Xoa san pham [@item.Name]?')">
                                <i class="bi bi-trash"></i> Xoa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted small">
        Tong cong: @(ViewBag.TotalItems ?? Model.Count()) san pham (trang @ViewBag.Page / @ViewBag.TotalPages)
    </div>
</div>

@* Thanh PHAN TRANG — giu lai tu khoa tim kiem + danh muc dang loc *@
@if ((int)(ViewBag.TotalPages ?? 1) > 1)
{
    int trangHienTai = (int)ViewBag.Page;
    int tongTrang = (int)ViewBag.TotalPages;
    string? kw = ViewBag.Search as string;
    int? catId = ViewBag.CategoryId as int?;

    <nav aria-label="Phan trang san pham" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(trangHienTai == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(trangHienTai - 1)"
                   asp-route-search="@kw" asp-route-categoryId="@catId">&laquo; Truoc</a>
            </li>

            @for (int i = 1; i <= tongTrang; i++)
            {
                <li class="page-item @(i == trangHienTai ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                       asp-route-search="@kw" asp-route-categoryId="@catId">@i</a>
                </li>
            }

            <li class="page-item @(trangHienTai == tongTrang ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(trangHienTai + 1)"
                   asp-route-search="@kw" asp-route-categoryId="@catId">Sau &raquo;</a>
            </li>
        </ul>
    </nav>
}
