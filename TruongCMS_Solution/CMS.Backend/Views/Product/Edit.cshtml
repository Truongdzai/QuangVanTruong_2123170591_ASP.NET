@model CMS.Data.Entities.Product

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua san pham"; }

<div class="card shadow">
    <div class="card-header bg-warning">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CHINH SUA SAN PHAM</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ten san pham: <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mo ta chi tiet:</label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Gia ban (VND):</label>
                            <input asp-for="Price" type="number" min="0" step="1000" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">So luong ton kho:</label>
                            <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
                        </div>
                    </div>
                    @* Bo chon mau (swatch) + chon size (chip) — DONG BO voi trang Them moi *@
                    <partial name="_ColorSizePicker" view-data='new ViewDataDictionary(ViewData) { ["CurrentColors"] = Model.Colors, ["CurrentSizes"] = Model.Sizes }' />
                    @if (!string.IsNullOrEmpty(Model.GalleryUrls))
                    {
                        <div class="mb-3 border rounded p-3 bg-light">
                            <label class="form-label fw-bold"><i class="bi bi-images"></i> Bo suu tap hien tai:</label>
                            <div class="d-flex gap-2 flex-wrap mb-2">
                                @foreach (var anh in Model.GalleryUrls.Split('\n'))
                                {
                                    <img src="@anh.Trim()" style="width:70px;height:70px;object-fit:cover;border-radius:6px"
                                         onerror="this.src='/images/no-image.svg'" />
                                }
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="clearGallery" value="true" class="form-check-input" id="clearGallery" />
                                <label class="form-check-label" for="clearGallery">Xoa het anh cu trong bo suu tap</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh muc san pham:</label>
                        <select asp-for="CategoryProductId" class="form-select"
                                asp-items="ViewBag.CategoryProductList">
                            <option value="">-- Chon danh muc --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Anh hien tai:</label>
                        <img id="anhXemTruoc"
                             src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.svg" : Model.ImageUrl)"
                             class="rounded border mb-2"
                             style="height:150px;object-fit:cover;width:100%"
                             onerror="this.src='/images/no-image.svg'" />
                        <label class="form-label">Cach 1 — UPLOAD file <span class="text-muted">(bo trong = giu cu)</span>:</label>
                        <input type="file" name="uploadImages" id="uploadImages"
                               class="form-control" accept="image/*" multiple
                               onchange="xemTruocAnh(this)" />
                        <div class="form-text">
                            Anh dau tien thay anh dai dien, cac anh sau NOI THEM vao bo suu tap.
                        </div>
                        <div id="anhThumbs" class="d-flex gap-2 flex-wrap mt-2"></div>
                        <label class="form-label fw-bold mt-3">Cach 2 — DAN URL anh (moi dong 1 link):</label>
                        <textarea name="imageUrlsText" class="form-control" rows="2"
                                  placeholder="https://.../anh.jpg"></textarea>
                    </div>
                    <hr />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Luu thay doi
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lai
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Xem truoc: anh DAU TIEN thay anh dai dien hien tai,
    // cac anh con lai hien thumbnail nho (se noi them vao bo suu tap)
    function xemTruocAnh(input) {
        var anhTo = document.getElementById('anhXemTruoc');
        var khungNho = document.getElementById('anhThumbs');
        khungNho.innerHTML = '';

        if (!input.files || input.files.length === 0) return;

        Array.from(input.files).forEach(function (file, i) {
            var reader = new FileReader();
            reader.onload = function (e) {
                if (i === 0) { anhTo.src = e.target.result; return; }
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.cssText = 'width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #dee2e6';
                khungNho.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }
</script>
}
