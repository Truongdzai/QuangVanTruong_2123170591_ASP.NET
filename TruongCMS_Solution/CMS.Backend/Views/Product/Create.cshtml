@model CMS.Data.Entities.Product

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Them san pham moi"; }

<div class="card shadow">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0"><i class="bi bi-box-seam"></i> THEM SAN PHAM MOI</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row">

                @* Cot trai: thong tin chinh *@
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ten san pham: <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Vi du: Dam da hoi dang xoe..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mo ta chi tiet:</label>
                        <textarea asp-for="Description" class="form-control" rows="5"
                                  placeholder="Mo ta chat lieu, kich thuoc, phong cach..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Gia ban (VND): <span class="text-danger">*</span></label>
                            <input asp-for="Price" type="number" min="0" step="1000"
                                   class="form-control" placeholder="Vi du: 350000" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">So luong ton kho:</label>
                            <input asp-for="StockQuantity" type="number" min="0"
                                   class="form-control" placeholder="Vi du: 50" />
                        </div>
                    </div>
                    @* Bo chon mau (swatch) + chon size (chip) — than thien, khong phai go tay *@
                    <partial name="_ColorSizePicker" view-data='new ViewDataDictionary(ViewData) { ["CurrentColors"] = Model.Colors, ["CurrentSizes"] = Model.Sizes }' />
                </div>

                @* Cot phai: danh muc + anh *@
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh muc san pham: <span class="text-danger">*</span></label>
                        <select asp-for="CategoryProductId" class="form-select"
                                asp-items="ViewBag.CategoryProductList">
                            <option value="">-- Chon danh muc --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Anh san pham — Cach 1: UPLOAD file (1 hoac nhieu):</label>
                        <input type="file" name="uploadImages" id="uploadImages"
                               class="form-control" accept="image/*" multiple
                               onchange="xemTruocAnh(this)" />
                        <div class="form-text">
                            Anh dau tien la anh dai dien, cac anh sau vao bo suu tap (gallery).
                        </div>
                        <img id="anhXemTruoc" src="/images/no-image.svg"
                             class="mt-2 rounded border"
                             style="height:150px;object-fit:cover;width:100%" />
                        <div id="anhThumbs" class="d-flex gap-2 flex-wrap mt-2"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cach 2: DAN URL anh (moi dong 1 link):</label>
                        <textarea name="imageUrlsText" class="form-control" rows="3"
                                  placeholder="https://.../anh1.jpg&#10;https://.../anh2.jpg"></textarea>
                        <div class="form-text">Co the dung CA upload + URL. Upload duoc uu tien xep truoc.</div>
                    </div>
                    <hr />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-cloud-arrow-up"></i> Luu san pham
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lai
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    // Xem truoc: anh DAU TIEN hien to (anh dai dien),
    // cac anh con lai hien thumbnail nho ben duoi (bo suu tap)
    function xemTruocAnh(input) {
        var anhTo = document.getElementById('anhXemTruoc');
        var khungNho = document.getElementById('anhThumbs');
        khungNho.innerHTML = '';

        if (!input.files || input.files.length === 0) {
            anhTo.src = '/images/no-image.svg';
            return;
        }

        Array.from(input.files).forEach(function (file, i) {
            var reader = new FileReader();
            reader.onload = function (e) {
                if (i === 0) { anhTo.src = e.target.result; return; }
                var img = document.createElement('img');
                img.src = e.target.result;
                img.style.cssText = 'width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #dee2e6';
                khungNho.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
    }
</script>
}
