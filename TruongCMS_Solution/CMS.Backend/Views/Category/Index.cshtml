@model IEnumerable<CMS.Data.Entities.Category>

@{ Layout = "_LayoutAdmin"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-dark mb-0">QUAN LY DANH MUC</h2>
    @* asp-action tu tao duong dan /Category/Create, khong can viet tay *@
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Them danh muc moi
    </a>
</div>

<partial name="_AdminSearch" view-data='new ViewDataDictionary(ViewData) { ["SearchPlaceholder"] = "Tìm theo tên / mô tả danh mục..." }' />

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-bordered mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:60px">ID</th>
                    <th>Ten danh muc</th>
                    <th>Mo ta</th>
                    <th style="width:160px" class="text-center">Thao tac</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="fw-bold">@item.Name</td>
                        <td class="text-muted">@item.Description</td>
                        <td class="text-center">
                            @* asp-route-id dinh kem id vao URL -> /Category/Edit/1 *@
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Sua
                            </a>
                            @* onclick confirm: hop thoai xac nhan truoc khi xoa *@
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Co chac chan muon xoa danh muc nay?')">
                                <i class="bi bi-trash"></i> Xoa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted small">Tong cong: @(ViewBag.TotalItems ?? Model.Count()) danh muc</div>
</div>

<partial name="_AdminPager" />
