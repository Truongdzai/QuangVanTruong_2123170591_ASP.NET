@model CMS.Data.Entities.Category

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Them danh muc"; }

<div class="card shadow" style="max-width:600px">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0"><i class="bi bi-plus-circle"></i> THEM DANH MUC MOI</h4>
    </div>
    <div class="card-body">
        @* asp-action="Create": form se POST toi CategoryController.Create(Category model) *@
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Ten danh muc:</label>
                @* asp-for="Name": tu tao name="Name" va gan gia tri Model.Name *@
                <input asp-for="Name" class="form-control" placeholder="Nhan vao ten danh muc..." />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Mo ta:</label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Mo ta ngan ve danh muc..."></textarea>
            </div>
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save"></i> Luu vao he thong
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Huy bo
            </a>
        </form>
    </div>
</div>
