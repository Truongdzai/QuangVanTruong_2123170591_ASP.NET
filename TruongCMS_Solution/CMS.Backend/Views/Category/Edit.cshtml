@model CMS.Data.Entities.Category

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua danh muc"; }

<div class="card shadow" style="max-width:600px">
    <div class="card-header bg-warning">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CHINH SUA DANH MUC</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @* Hidden giu Id: QUAN TRONG - neu thieu, controller khong biet dang sua dong nao *@
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Ten danh muc:</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Mo ta:</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-save"></i> Cap nhat thay doi
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Huy bo
            </a>
        </form>
    </div>
</div>
