@*
    Thanh PHAN TRANG dung chung — giu lai tu khoa tim kiem khi chuyen trang.
    Yeu cau Index controller set: ViewBag.Page, ViewBag.TotalPages, ViewBag.Search.
*@
@{
    int page = (int)(ViewBag.Page ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string? search = ViewBag.Search as string;
}
@if (totalPages > 1)
{
    <nav aria-label="Phan trang" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@action" asp-route-page="@(page - 1)" asp-route-search="@search">&laquo; Trước</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="@action" asp-route-page="@i" asp-route-search="@search">@i</a>
                </li>
            }
            <li class="page-item @(page == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@action" asp-route-page="@(page + 1)" asp-route-search="@search">Sau &raquo;</a>
            </li>
        </ul>
    </nav>
}
