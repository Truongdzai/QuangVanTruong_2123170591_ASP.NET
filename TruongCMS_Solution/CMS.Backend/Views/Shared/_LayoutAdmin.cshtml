<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TruongCMS Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #1a1d23;
            color: white;
        }
        .sidebar .nav-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6c757d;
            padding: 12px 20px 4px;
        }
        .sidebar a.nav-link {
            color: #adb5bd;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }
        .sidebar a.nav-link:hover {
            background-color: #2c3036;
            color: #fff;
            border-left-color: #0d6efd;
        }
        .sidebar a.nav-link.active {
            background-color: #0d6efd22;
            color: #4d9fff;
            border-left-color: #0d6efd;
        }
        .sidebar .divider {
            border-color: #2c3036;
            margin: 6px 0;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">

            @* ===== SIDEBAR ===== *@
            <nav class="col-md-3 col-lg-2 sidebar p-0">

                @* Logo khu quan tri *@
                <div class="p-3 text-center border-bottom" style="border-color:#2c3036!important">
                    <h5 class="text-white mb-1">
                        <i class="bi bi-shield-lock-fill text-primary"></i> TruongCMS
                    </h5>
                    <small class="text-muted">He thong quan tri</small>
                </div>

                <div class="mt-1 pb-3">

                    @* ---- Tong quan ---- *@
                    <div class="nav-label">Tong quan</div>
                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Bang dieu khien
                    </a>

                    <hr class="divider mx-3" />

                    @* ---- Tin tuc / CMS ---- *@
                    <div class="nav-label">Tin tuc &amp; Noi dung</div>
                    <a class="nav-link" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-grid-3x3-gap"></i> Danh muc tin
                    </a>
                    <a class="nav-link" asp-controller="Post" asp-action="Index">
                        <i class="bi bi-file-earmark-post"></i> Bai viet
                    </a>

                    <hr class="divider mx-3" />

                    @* ---- E-Commerce ---- *@
                    <div class="nav-label">Thuong mai dien tu</div>
                    <a class="nav-link" asp-controller="CategoryProduct" asp-action="Index">
                        <i class="bi bi-tags"></i> Danh muc san pham
                    </a>
                    <a class="nav-link" asp-controller="Product" asp-action="Index">
                        <i class="bi bi-box-seam"></i> San pham
                    </a>
                    <a class="nav-link" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-bag-check"></i> Don hang
                    </a>
                    <a class="nav-link" asp-controller="Customer" asp-action="Index">
                        <i class="bi bi-person-lines-fill"></i> Khach hang
                    </a>
                    @* Buoi 11: Sale + Kho hang *@
                    <a class="nav-link" asp-controller="Sale" asp-action="Index">
                        <i class="bi bi-percent"></i> Sale / Ma giam gia
                    </a>
                    <a class="nav-link" asp-controller="FlashSale" asp-action="Index">
                        <i class="bi bi-lightning-charge"></i> Flash Sale
                    </a>
                    <a class="nav-link" asp-controller="Inventory" asp-action="Index">
                        <i class="bi bi-box-arrow-in-down"></i> Kho hang (Nhap hang)
                    </a>
                    <a class="nav-link" asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-graph-up-arrow"></i> Bao cao &amp; Thong ke
                    </a>

                    <hr class="divider mx-3" />

                    @* ---- Giao dien trang chu ---- *@
                    <div class="nav-label">Giao dien</div>
                    <a class="nav-link" asp-controller="Banner" asp-action="Index">
                        <i class="bi bi-images"></i> Banner trang chu
                    </a>
                    <a class="nav-link" asp-controller="Footer" asp-action="Index">
                        <i class="bi bi-layout-text-window-reverse"></i> Footer dong
                    </a>

                    <hr class="divider mx-3" />

                    @* ---- He thong ---- *@
                    <div class="nav-label">He thong</div>
                    <a class="nav-link" asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i> Thanh vien quan tri
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link" href="/hangfire" target="_blank">
                            <i class="bi bi-cpu"></i> Tac vu nen (Hangfire)
                        </a>
                        <a class="nav-link" href="/swagger" target="_blank">
                            <i class="bi bi-filetype-json"></i> Swagger API
                        </a>
                    }

                </div>
            </nav>

            @* ===== VUNG NOI DUNG CHINH ===== *@
            <main class="col-md-9 col-lg-10 ms-sm-auto p-0">

                @* Thanh tieu de: ten nguoi dung + nut dang xuat *@
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="d-flex justify-content-between align-items-center px-4 py-2 bg-white border-bottom shadow-sm">
                        <span class="text-muted small">
                            <i class="bi bi-person-circle me-1"></i>
                            Xin chao, <strong>@User.FindFirst("FullName")?.Value</strong>
                            <span class="badge bg-secondary ms-1">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </span>
                        </span>
                        <a class="btn btn-outline-danger btn-sm"
                           asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right me-1"></i>Dang xuat
                        </a>
                    </div>
                }

                <div class="p-4">
                    @RenderBody()
                </div>

            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
