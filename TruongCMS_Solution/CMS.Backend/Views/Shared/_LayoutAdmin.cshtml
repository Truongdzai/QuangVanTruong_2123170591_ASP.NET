<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TruongCMS Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #212529;
            color: white;
        }
        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            display: block;
            padding: 10px 20px;
        }
        .sidebar a:hover {
            background-color: #343a40;
            color: white;
        }
        .sidebar .active {
            background-color: #0d6efd;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">

            @*  SIDEBAR TRAI *@
            <nav class="col-md-3 col-lg-2 sidebar p-0">

                @* Tieu de khu quan tri *@
                <div class="p-3 text-center border-bottom border-secondary">
                    <h5 class="text-white mb-0">
                        <i class="bi bi-shield-lock"></i> TruongCMS Admin
                    </h5>
                </div>

                @* Menu dieu huong - asp-controller/asp-action tu sinh URL chinh xac *@
                <div class="mt-2">
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Bang dieu khien
                    </a>
                    <a asp-controller="Category" asp-action="Index">
                        <i class="bi bi-grid"></i> Quan ly Danh muc
                    </a>
                    <a asp-controller="Post" asp-action="Index">
                        <i class="bi bi-file-earmark-post"></i> Quan ly Bai viet
                    </a>
                    <a asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i> Quan ly Thanh vien
                    </a>
                </div>
            </nav>

            @*  VUNG NOI DUNG CHINH (phai) 
               @RenderBody(): noi dung cua tung View se duoc "do" vao day
               LUU Y: chi goi @RenderBody() DUNG MOT LAN, khong de trong comment HTML *@
            <main class="col-md-9 col-lg-10 ms-sm-auto p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
