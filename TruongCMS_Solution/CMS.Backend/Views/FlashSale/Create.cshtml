@model CMS.Data.Entities.FlashSale

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Tạo Flash Sale"; }

<h4 class="mb-3"><i class="bi bi-lightning-charge-fill text-warning"></i> TẠO CHƯƠNG TRÌNH FLASH SALE</h4>

<div class="card shadow-sm" style="max-width:560px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên chương trình</label>
                <input asp-for="Name" class="form-control" placeholder="VD: Flash Sale 12.12 khung 12h-15h" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="StartTime" class="form-label">Bắt đầu</label>
                    <input asp-for="StartTime" type="datetime-local" class="form-control" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="EndTime" class="form-label">Kết thúc</label>
                    <input asp-for="EndTime" type="datetime-local" class="form-control" />
                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Kích hoạt chương trình</label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Tạo &amp; thêm sản phẩm</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
