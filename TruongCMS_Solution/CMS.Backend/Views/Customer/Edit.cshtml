@model CMS.Data.Entities.Customer

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua thong tin khach hang"; }

<div class="card shadow" style="max-width:600px">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="bi bi-person-gear"></i> SUA THONG TIN KHACH HANG #@Model.Id</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Email (khong sua duoc):</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ho ten: <span class="text-danger">*</span></label>
                <input name="fullName" class="form-control" value="@Model.FullName" required />
                <span class="text-danger">@Html.ValidationMessage("FullName")</span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">So dien thoai:</label>
                <input name="phone" class="form-control" value="@Model.Phone" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Dia chi:</label>
                <textarea name="address" class="form-control" rows="2">@Model.Address</textarea>
            </div>

            <div class="alert alert-secondary small">
                <i class="bi bi-shield-lock"></i> Mat khau khach hang da duoc ma hoa mot chieu (SHA256 + Salt)
                — admin khong the xem hay sua truc tiep tai day.
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Luu thay doi
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lai
                </a>
            </div>
        </form>
    </div>
</div>
