@model CMS.Data.Entities.Customer

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Chi tiet Khach hang"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-person-circle"></i> CHI TIET KHACH HANG #@Model.Id</h4>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lai danh sach
    </a>
</div>

<div class="row g-4">
    @* Card thong tin ca nhan *@
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-person-badge"></i> Thong tin ca nhan
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Ho ten:</dt>
                    <dd class="col-7 fw-bold">@Model.FullName</dd>

                    <dt class="col-5 text-muted">Email:</dt>
                    <dd class="col-7">@Model.Email</dd>

                    <dt class="col-5 text-muted">Dien thoai:</dt>
                    <dd class="col-7">@(Model.Phone ?? "Chua cap nhat")</dd>

                    <dt class="col-5 text-muted">Dia chi:</dt>
                    <dd class="col-7">@(Model.Address ?? "Chua cap nhat")</dd>

                    <dt class="col-5 text-muted">Tong don:</dt>
                    <dd class="col-7">
                        <span class="badge bg-primary">@Model.Orders.Count don hang</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    @* Lich su don hang *@
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <i class="bi bi-bag-check"></i> Lich su don hang (@Model.Orders.Count)
            </div>
            <div class="card-body p-0">
                @if (!Model.Orders.Any())
                {
                    <p class="text-muted p-3 mb-0">Khach hang chua co don hang nao.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ma don</th>
                                <th>Ngay dat</th>
                                <th>So san pham</th>
                                <th>Trang thai</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                            {
                                <tr>
                                    <td class="fw-bold">#@order.Id</td>
                                    <td class="small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">@order.OrderDetails.Count SP</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case 0: <span class="badge bg-warning text-dark">Cho duyet</span> break;
                                            case 1: <span class="badge bg-info text-dark">Dang giao</span> break;
                                            case 2: <span class="badge bg-success">Hoan thanh</span> break;
                                            default: <span class="badge bg-secondary">@order.Status</span> break;
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
