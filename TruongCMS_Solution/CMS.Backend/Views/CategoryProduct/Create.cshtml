@model CMS.Data.Entities.CategoryProduct

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Them danh muc san pham"; }

<div class="card shadow" style="max-width:600px">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-plus-circle"></i> THEM DANH MUC SAN PHAM</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Ten danh muc: <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Vi du: Thoi trang nu, Ao so mi nam..." required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Mo ta:</label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Mo ta ngan ve danh muc nay..."></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Luu danh muc
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lai
                </a>
            </div>
        </form>
    </div>
</div>
