@model CMS.Data.Entities.CategoryProduct

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua danh muc san pham"; }

<div class="card shadow" style="max-width:600px">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> SUA DANH MUC SAN PHAM</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label fw-bold">Ten danh muc: <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Mo ta:</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Luu thay doi
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lai
                </a>
            </div>
        </form>
    </div>
</div>
