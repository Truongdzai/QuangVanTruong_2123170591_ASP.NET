    Nang cap theo BAO CAO NGHIEN CUU: 6 trang thai theo quy trinh chuan
    (Cho xac nhan -> Da gom hang -> Dang giao -> Thanh cong / Da huy / Hoan tra)
*@
@model IEnumerable<CMS.Data.Entities.Order>
@using CMS.Data.Entities

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quan ly Don hang";
    int? locTrangThai = ViewBag.LocTrangThai as int?;

    string BadgeClass(int st) => st switch
    {
        OrderStatusFlow.ChoXacNhan => "bg-warning text-dark",
        OrderStatusFlow.DaGomHang  => "bg-primary",
        OrderStatusFlow.DangGiao   => "bg-info text-dark",
        OrderStatusFlow.ThanhCong  => "bg-success",
        OrderStatusFlow.DaHuy      => "bg-secondary",
        OrderStatusFlow.HoanTra    => "bg-danger",
        _ => "bg-light text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-bag-check"></i> QUAN LY DON HANG</h4>
    <div class="btn-group btn-group-sm" role="group">
        <a asp-action="Index" class="btn @(locTrangThai == null ? "btn-dark" : "btn-outline-dark")">
            Tất cả
        </a>
        @foreach (var st in new[] { OrderStatusFlow.ChoXacNhan, OrderStatusFlow.DaGomHang, OrderStatusFlow.DangGiao, OrderStatusFlow.ThanhCong, OrderStatusFlow.DaHuy, OrderStatusFlow.HoanTra })
        {
            <a asp-action="Index" asp-route-status="@st"
               class="btn @(locTrangThai == st ? "btn-dark" : "btn-outline-dark")">
                @OrderStatusFlow.TenTrangThai(st)
                <span class="badge @BadgeClass(st) ms-1">@Model.Count(o => o.Status == st)</span>
            </a>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-bordered mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width:70px">Ma don</th>
                    <th>Khach hang</th>
                    <th style="width:140px">Ngay dat hang</th>
                    <th style="width:70px" class="text-center">So SP</th>
                    <th style="width:120px" class="text-end">Tong tien</th>
                    <th style="width:130px" class="text-center">Thanh toan</th>
                    <th style="width:120px" class="text-center">Trang thai</th>
                    <th style="width:100px" class="text-center">Thao tac</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">#@order.Id</td>
                        <td>
                            @if (order.Customer != null)
                            {
                                <div class="fw-bold">@order.Customer.FullName</div>
                                <small class="text-muted">@order.Customer.Phone</small>
                            }
                            else
                            {
                                <span class="text-muted">ID: @order.CustomerId</span>
                            }
                        </td>
                        <td class="small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@order.OrderDetails.Count</span>
                        </td>
                        <td class="text-end fw-bold">@order.TotalAmount.ToString("N0") đ</td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border">@order.PaymentMethod</span>
                            @if (order.PaymentStatus == 1)
                            {
                                <i class="bi bi-check-circle-fill text-success" title="Da thanh toan"></i>
                            }
                            else if (order.PaymentStatus == 2)
                            {
                                <i class="bi bi-arrow-counterclockwise text-danger" title="Da hoan tien"></i>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @BadgeClass(order.Status)">@OrderStatusFlow.TenTrangThai(order.Status)</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@order.Id"
                               class="btn btn-sm btn-primary me-1">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@order.Id"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Xoa don hang #@order.Id?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer text-muted small">
        Tong cong: @Model.Count() don hang — Doanh thu don thanh cong:
        <b>@Model.Where(o => o.Status == OrderStatusFlow.ThanhCong).Sum(o => o.TotalAmount).ToString("N0") đ</b>
    </div>
</div>
