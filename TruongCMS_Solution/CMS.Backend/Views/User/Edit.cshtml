@model CMS.Data.Entities.User

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua thanh vien"; }

<div class="card shadow" style="max-width:520px; margin:auto">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> SUA THONG TIN THANH VIEN</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">

            @* Id phai gui kem de controller biet dang sua ban ghi nao *@
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Ten dang nhap:</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mat khau:</label>
                <input asp-for="PasswordHash" type="password" class="form-control" />
                <div class="form-text">De trong neu khong muon doi mat khau.</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ho va ten:</label>
                <input asp-for="FullName" class="form-control" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Quyen han:</label>
                <select asp-for="Role" class="form-select" asp-items="ViewBag.RoleList">
                    <option value="">-- Chon quyen --</option>
                </select>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-warning text-dark">
                    <i class="bi bi-check-circle"></i> Luu thay doi
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lai danh sach
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
