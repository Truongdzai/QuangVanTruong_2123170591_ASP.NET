@model IEnumerable<CMS.Data.Entities.Post>

@* Ap dung layout admin co sidebar thay cho layout mac dinh *@
@{
    Layout = "_LayoutAdmin";

    // Content gio la ma HTML (CKEditor) -> got the tag de hien mo ta ngan gon gang
    string XoaTheHtml(string html) =>
        System.Text.RegularExpressions.Regex.Replace(html ?? "", "<[^>]+>", " ").Trim();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-dark mb-0">DANH SACH BAI VIET</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Them bai viet moi
    </a>
</div>

@* Tim kiem theo tieu de / noi dung (giu lai khi loc danh muc qua route id) *@
<form method="get" asp-action="Index" class="card shadow-sm mb-3">
    <input type="hidden" name="id" value="@ViewBag.CategoryId" />
    <div class="card-body row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="search" value="@(ViewBag.Search as string)" class="form-control"
                   placeholder="Tìm bài viết theo tiêu đề / nội dung..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search"></i> Tìm</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Index" asp-route-id="@ViewBag.CategoryId" class="btn btn-outline-secondary">Xóa</a>
            }
        </div>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                @* Neu khong co anh -> hien anh mac dinh, onerror phong link chet *@
                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.svg" : item.ImageUrl)"
                     class="card-img-top"
                     style="height:180px; object-fit:cover"
                     alt="@item.Title"
                     onerror="this.src='/images/no-image.svg'" />

                <div class="card-body d-flex flex-column">
                    @* Badge ten danh muc - lay duoc nho .Include(p -> p.Category) trong Controller *@
                    <span class="badge bg-info text-dark mb-2 align-self-start">
                        @item.Category?.Name
                    </span>

                    <h6 class="card-title text-primary fw-bold">@item.Title</h6>
                    <p class="card-text text-truncate text-muted small flex-grow-1">@XoaTheHtml(item.Content)</p>
                    <p class="text-muted small">Ngay dang: @item.CreatedDate.ToString("dd/MM/yyyy")</p>

                    @* 3 nut hanh dong: Chi tiet / Sua / Xoa *@
                    <div class="d-flex gap-1 mt-auto">
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm flex-fill">
                            <i class="bi bi-eye"></i> Chi tiet
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-outline-warning btn-sm flex-fill">
                            <i class="bi bi-pencil"></i> Sua
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-outline-danger btn-sm flex-fill"
                           onclick="return confirm('Co chac chan muon xoa bai viet nay?')">
                            <i class="bi bi-trash"></i> Xoa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* Tieu chi 14: thanh PHAN TRANG khi danh sach bai viet qua dai (5 bai/trang) *@
@if ((int)(ViewBag.TotalPages ?? 1) > 1)
{
    int trangHienTai = (int)ViewBag.Page;
    int tongTrang = (int)ViewBag.TotalPages;

    <nav aria-label="Phan trang bai viet" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(trangHienTai == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-id="@ViewBag.CategoryId"
                   asp-route-search="@(ViewBag.Search as string)" asp-route-page="@(trangHienTai - 1)">&laquo; Truoc</a>
            </li>

            @for (int i = 1; i <= tongTrang; i++)
            {
                <li class="page-item @(i == trangHienTai ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-id="@ViewBag.CategoryId"
                       asp-route-search="@(ViewBag.Search as string)" asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(trangHienTai == tongTrang ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-id="@ViewBag.CategoryId"
                   asp-route-search="@(ViewBag.Search as string)" asp-route-page="@(trangHienTai + 1)">Sau &raquo;</a>
            </li>
        </ul>
    </nav>
}
