@* View danh sách bài viết dạng card — Model là List<Post> từ PostController *@
@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <h2 class="mb-4 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>

    @* row: lưới Bootstrap; mỗi bài 1 cột col-md-4 (3 card/hàng) *@
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    @* Ảnh đại diện từ cột ImageUrl trong database *@
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary">@item.Title</h5>

                        @* text-truncate: cắt ngắn nội dung trên card *@
                        <p class="card-text text-truncate">@item.Content</p>

                        <p class="text-muted small mt-auto mb-3">
                            Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        @* Tag Helper: tạo link /Post/Details/{id} — không hard-code URL *@
                        <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm mt-auto">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
