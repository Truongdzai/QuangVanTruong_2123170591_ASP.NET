@*
Quang Van Truong || 2123170591
Buổi 3: Danh sách bài viết — badge danh mục, ảnh fallback, nút CRUD
*@
@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger mb-0">DANH SÁCH BÀI VIẾT</h2>
        <a asp-action="Create" class="btn btn-danger">
            + Thêm bài viết mới
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    @* Fallback: nếu ImageUrl null/rỗng → dùng no-image.svg *@
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.svg" : item.ImageUrl)"
                         class="card-img-top"
                         style="height:180px;object-fit:cover"
                         alt="@item.Title"
                         onerror="this.src='/images/no-image.svg'" />

                    <div class="card-body d-flex flex-column">
                        @* Badge tên danh mục — có nhờ .Include(p => p.Category) *@
                        <span class="badge bg-info text-dark mb-2 align-self-start">
                            @item.Category?.Name
                        </span>

                        <h6 class="card-title text-primary fw-bold">@item.Title</h6>
                        <p class="card-text text-truncate text-muted small">@item.Content</p>

                        <p class="text-muted small mt-auto mb-2">
                            Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm flex-fill">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-outline-warning btn-sm flex-fill">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm flex-fill"
                               onclick="return confirm('Xóa bài viết này?')">Xóa</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
