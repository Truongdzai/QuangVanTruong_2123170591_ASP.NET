@* View chi tiết 1 bài viết — @model là 1 object Post (không phải IEnumerable) *@
@model CMS.Data.Entities.Post

<div class="container mt-5">
    @* Breadcrumb: đường dẫn điều hướng *@
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Post" asp-action="Index">Danh sách bài viết</a>
            </li>
            <li class="breadcrumb-item active">Chi tiết bài viết</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <h1 class="display-5 fw-bold text-primary">@Model.Title</h1>
            <p class="text-muted">Đăng ngày: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
            <hr />

            @* Chỉ hiện ảnh nếu ImageUrl không rỗng *@
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="text-center mb-4">
                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="Post Image" />
                </div>
            }

            @* Nội dung đầy đủ (khác trang Index chỉ hiện truncate) *@
            <div class="post-content fs-5">
                @Model.Content
            </div>

            <div class="mt-5 border-top pt-3">
                <a asp-controller="Post" asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>
