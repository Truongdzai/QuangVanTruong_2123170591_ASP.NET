@model CMS.Data.Entities.Post

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Chi tiet bai viet"; }

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sach bai viet</a></li>
        <li class="breadcrumb-item active">Chi tiet</li>
    </ol>
</nav>

<div class="card shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-file-earmark-text"></i> Chi tiet bai viet</span>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
            <i class="bi bi-pencil"></i> Sua bai nay
        </a>
    </div>
    <div class="card-body">

        @* Anh dai dien - hien anh that hoac anh mac dinh neu thieu *@
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.svg" : Model.ImageUrl)"
             class="img-fluid rounded shadow mb-4"
             style="max-height:350px; object-fit:cover; width:100%"
             alt="@Model.Title"
             onerror="this.src='/images/no-image.svg'" />

        @* Badge danh muc - lay duoc nho .Include(Category) trong Controller *@
        <span class="badge bg-info text-dark fs-6 mb-2">@Model.Category?.Name</span>

        <h1 class="display-6 fw-bold text-primary mt-2">@Model.Title</h1>
        <p class="text-muted">Dang ngay: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
        <hr />

        <div class="fs-5 lh-lg">@Model.Content</div>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay lai
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Sua bai viet
            </a>
        </div>
    </div>
</div>
