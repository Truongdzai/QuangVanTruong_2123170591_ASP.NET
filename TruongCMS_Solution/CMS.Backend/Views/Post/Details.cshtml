@*
Quang Van Truong || 2123170591
Buổi 3: Chi tiết bài viết — ảnh fallback, tên danh mục, nút Sửa/Quay lại
*@
@model CMS.Data.Entities.Post

<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Post" asp-action="Index">Danh sách bài viết</a>
            </li>
            <li class="breadcrumb-item active">Chi tiết</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-10">
            @* Badge danh mục *@
            <span class="badge bg-info text-dark fs-6 mb-3">@Model.Category?.Name</span>

            <h1 class="display-5 fw-bold text-primary">@Model.Title</h1>
            <p class="text-muted">Đăng ngày: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
            <hr />

            @* Ảnh: hiện ảnh thật hoặc fallback no-image.svg, dùng onerror phòng link chết *@
            <div class="text-center mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.svg" : Model.ImageUrl)"
                     class="img-fluid rounded shadow"
                     style="max-height:400px;object-fit:cover;width:100%"
                     alt="@Model.Title"
                     onerror="this.src='/images/no-image.svg'" />
            </div>

            <div class="post-content fs-5 lh-lg">
                @Model.Content
            </div>

            <div class="mt-5 border-top pt-3 d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa bài viết</a>
            </div>
        </div>
    </div>
</div>
