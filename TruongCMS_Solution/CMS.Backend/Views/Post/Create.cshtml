@model CMS.Data.Entities.Post

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Them bai viet moi"; }

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-file-earmark-plus"></i> THEM BAI VIET MOI</h4>
    </div>
    <div class="card-body">
        @* enctype multipart: bat buoc khi form co upload file anh *@
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @* Tom tat loi server tra ve (vd thieu tieu de/noi dung) — tranh trang 500 *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row">

                @* Cot trai: tieu de + noi dung *@
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tieu de bai viet:</label>
                        <input asp-for="Title" class="form-control" placeholder="Nhap tieu de..." />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Noi dung chi tiet:</label>
                        @* Tieu chi 15 + 35: o nhap lieu nay duoc CKEditor 5 thay the
                           thanh trinh soan thao giau tinh nang (chu dam, nghieng, can le,
                           chen anh truc tiep vao giua bai). Content luu duoi dang ma HTML. *@
                        <textarea asp-for="Content" id="editorContent" class="form-control" rows="10"
                                  placeholder="Viet noi dung tai day..."></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                </div>

                @* Cot phai: danh muc, anh, ngay dang *@
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chuyen muc:</label>
                        @* asp-items lay du lieu tu ViewBag.CategoryList do controller truyen sang *@
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                            <option value="">-- Chon danh muc --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Anh dai dien:</label>
                        @* name="uploadImage" phai khop voi ten tham so IFormFile trong Controller *@
                        <input type="file" name="uploadImage" id="uploadImage"
                               class="form-control" accept="image/*"
                               onchange="xemTruocAnh(this)" />
                        <img id="anhXemTruoc" src="/images/no-image.svg"
                             class="mt-2 rounded border"
                             style="height:140px; object-fit:cover; width:100%" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngay dang:</label>
                        @* asp-for tu lay CreatedDate tu model (da set = DateTime.Now trong controller)
                           Khong dung them value="" vi Tag Helper se bi ghi de, gay sai gia tri *@
                        <input asp-for="CreatedDate" type="date" class="form-control" />
                    </div>

                    <hr />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-cloud-arrow-up"></i> Luu va Dang bai
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lai danh sach
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
@* Kiem tra hop le phia client (jQuery unobtrusive) cho Title/Chuyen muc *@
<partial name="_ValidationScriptsPartial" />
@* Tieu chi 15: nap CKEditor 5 (ban classic) tu CDN *@
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/translations/vi.js"></script>
<script>
    // Xem truoc anh ngay khi nguoi dung chon file, khong can upload len server truoc
    function xemTruocAnh(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('anhXemTruoc').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Tieu chi 15 + 35: bien textarea Content thanh trinh soan thao CKEditor.
    // ckfinder.uploadUrl: anh keo-tha/chon trong editor se POST len /Post/UploadImage,
    // server tra ve { uploaded, url } -> CKEditor tu chen <img src="url"> vao giua bai viet.
    ClassicEditor
        .create(document.querySelector('#editorContent'), {
            language: 'vi',
            ckfinder: { uploadUrl: '/Post/UploadImage' },
            toolbar: [
                'heading', '|',
                'bold', 'italic', 'link', '|',
                'bulletedList', 'numberedList', 'blockQuote', '|',
                'imageUpload', 'insertTable', 'mediaEmbed', '|',
                'undo', 'redo'
            ]
        })
        .then(editor => { window._editor = editor; })
        .catch(err => console.error('Loi khoi tao CKEditor:', err));
</script>
}
