@model CMS.Data.Entities.Post

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Sua bai viet"; }

<div class="card shadow">
    <div class="card-header bg-warning">
        <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CHINH SUA BAI VIET</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @* Tom tat loi server tra ve (vd thieu tieu de/noi dung) — tranh trang 500 *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            @* Hidden: giu Id de controller biet dang sua dong nao *@
            <input type="hidden" asp-for="Id" />
            @* Hidden: giu ImageUrl cu, neu khong upload anh moi thi controller dung lai gia tri nay *@
            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="CreatedDate" />

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tieu de bai viet:</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Noi dung chi tiet:</label>
                        @* Tieu chi 15 + 35: CKEditor 5 thay the textarea, ho tro dinh dang
                           va chen anh truc tiep vao noi dung (luu duoi dang ma HTML) *@
                        <textarea asp-for="Content" id="editorContent" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chuyen muc:</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                            <option value="">-- Chon danh muc --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Anh hien tai:</label>
                        @* Hien anh dang luu trong DB (anh upload hoac URL ngoai) *@
                        <img id="anhXemTruoc"
                             src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.svg" : Model.ImageUrl)"
                             class="rounded border mb-2"
                             style="height:140px; object-fit:cover; width:100%"
                             onerror="this.src='/images/no-image.svg'" />

                        <label class="form-label">
                            Thay anh moi <span class="text-muted">(bo trong = giu anh cu)</span>:
                        </label>
                        <input type="file" name="uploadImage" id="uploadImage"
                               class="form-control" accept="image/*"
                               onchange="xemTruocAnh(this)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngay dang:</label>
                        <input asp-for="CreatedDate" type="date" class="form-control" />
                    </div>

                    <hr />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Luu thay doi
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lai danh sach
                        </a>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
@* Kiem tra hop le phia client (jQuery unobtrusive) cho Title/Chuyen muc *@
<partial name="_ValidationScriptsPartial" />
@* Tieu chi 15: nap CKEditor 5 (ban classic) tu CDN *@
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/translations/vi.js"></script>
<script>
    function xemTruocAnh(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('anhXemTruoc').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Tieu chi 15 + 35: khoi tao CKEditor tren o noi dung, upload anh ve /Post/UploadImage
    ClassicEditor
        .create(document.querySelector('#editorContent'), {
            language: 'vi',
            ckfinder: { uploadUrl: '/Post/UploadImage' },
            toolbar: [
                'heading', '|',
                'bold', 'italic', 'link', '|',
                'bulletedList', 'numberedList', 'blockQuote', '|',
                'imageUpload', 'insertTable', 'mediaEmbed', '|',
                'undo', 'redo'
            ]
        })
        .then(editor => { window._editor = editor; })
        .catch(err => console.error('Loi khoi tao CKEditor:', err));
</script>
}
