@*
    Ho ten: Quang Van Truong || MSV: 2123170591
    Nang cap theo BAO CAO NGHIEN CUU: bang bien the SKU cua san pham
    (gia rieng theo size — test case 3; ton kho rieng — test case 2; anh theo mau — test case 1)
*@
@model CMS.Data.Entities.Product

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Biến thể SKU"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
        <i class="bi bi-boxes"></i> BIẾN THỂ SKU — @Model.Name
        <span class="badge bg-secondary ms-2">Tồn tổng: @Model.StockQuantity</span>
    </h4>
    <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Về danh sách SP
    </a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"]   != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="card shadow-sm mb-4">
    <div class="card-header bg-warning"><i class="bi bi-plus-circle"></i> Thêm biến thể (Màu × Size)</div>
    <div class="card-body">
        <form asp-action="Add" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="col-md-2">
                <label class="form-label small">Màu (tên/hex)</label>
                <input name="color" class="form-control" placeholder="trắng / #FFFFFF" required />
            </div>
            <div class="col-md-1">
                <label class="form-label small">Size</label>
                <input name="size" class="form-control" placeholder="M" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Giá riêng (trống = gốc @Model.Price.ToString("N0"))</label>
                <input name="priceOverride" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-1">
                <label class="form-label small">Tồn</label>
                <input name="stockQuantity" type="number" min="0" value="10" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small">URL ảnh theo màu</label>
                <input name="imageUrl" class="form-control" placeholder="https://..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small">…hoặc upload ảnh</label>
                <input name="imageFile" type="file" accept="image/*" class="form-control" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-warning w-100"><i class="bi bi-plus-lg"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-secondary text-white">
        <i class="bi bi-list-ul"></i> Danh sách biến thể (@Model.Variants.Count)
    </div>
    <div class="card-body p-0">
        @if (!Model.Variants.Any())
        {
            <p class="text-muted p-3 mb-0">
                Sản phẩm chưa có biến thể — khách sẽ mua theo tồn kho tổng (@Model.StockQuantity).
            </p>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px">Ảnh</th>
                        <th style="width:120px">SKU</th>
                        <th style="width:130px">Màu</th>
                        <th style="width:90px">Size</th>
                        <th style="width:130px" class="text-end">Giá riêng</th>
                        <th style="width:100px" class="text-center">Tồn kho</th>
                        <th style="width:90px" class="text-center">Bật</th>
                        <th>Ảnh theo màu (URL)</th>
                        <th style="width:130px" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Variants.OrderBy(x => x.Color).ThenBy(x => x.Size))
                    {
                        @* Form cap nhat dat trong 1 o; cac input o cac o khac tro ve form bang
                           thuoc tinh form="..." (HTML5) de giu bang hop le *@
                        string formId = $"frm-variant-{v.Id}";
                        <tr class="@(v.StockQuantity == 0 ? "table-danger" : v.IsActive ? "" : "table-secondary")">
                            <td>
                                <img src="@(string.IsNullOrEmpty(v.ImageUrl) ? (Model.ImageUrl ?? "/images/no-image.svg") : v.ImageUrl)"
                                     style="width:42px;height:42px;object-fit:cover;border-radius:4px"
                                     onerror="this.src='/images/no-image.svg'" />
                            </td>
                            <td><code class="small">@v.Sku</code></td>
                            <td>
                                <span class="d-inline-block border rounded-circle me-1"
                                      style="width:16px;height:16px;background:@v.Color;vertical-align:-2px"></span>
                                @(v.ColorName ?? v.Color)
                            </td>
                            <td>@v.Size</td>
                            <td>
                                <input name="priceOverride" form="@formId" type="number" step="0.01" min="0"
                                       value="@(v.PriceOverride?.ToString("0.##"))"
                                       class="form-control form-control-sm text-end"
                                       placeholder="@Model.Price.ToString("0.##")" />
                            </td>
                            <td>
                                <input name="stockQuantity" form="@formId" type="number" min="0" value="@v.StockQuantity"
                                       class="form-control form-control-sm text-center" />
                            </td>
                            <td class="text-center">
                                <input name="isActive" form="@formId" type="checkbox" value="true" class="form-check-input"
                                       checked="@(v.IsActive ? "checked" : null)" />
                                <input type="hidden" name="isActive" form="@formId" value="false" />
                            </td>
                            <td>
                                <input name="imageUrl" form="@formId" value="@v.ImageUrl"
                                       class="form-control form-control-sm mb-1" placeholder="URL ảnh / để trống = ảnh SP gốc" />
                                <input name="imageFile" form="@formId" type="file" accept="image/*"
                                       class="form-control form-control-sm" title="Hoặc upload ảnh mới" />
                            </td>
                            <td class="text-center">
                                <form asp-action="Update" method="post" enctype="multipart/form-data" id="@formId" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary" title="Lưu dòng này">
                                        <i class="bi bi-save"></i>
                                    </button>
                                </form>
                                <form asp-action="Remove" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Xóa biến thể @v.ColorName / @v.Size?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">
        Biến thể hết hàng (tồn = 0) chỉ khóa nút mua của <b>riêng tổ hợp đó</b> trên web khách —
        các size/màu khác vẫn bán bình thường (test case 2). Tồn kho tổng của sản phẩm
        tự đồng bộ = tổng các biến thể đang bật.
    </div>
</div>
