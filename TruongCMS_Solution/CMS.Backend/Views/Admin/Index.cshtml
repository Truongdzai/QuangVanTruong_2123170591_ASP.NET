@model IEnumerable<CMS.Data.Entities.Post>

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Bang dieu khien"; }

<h4 class="mb-4"><i class="bi bi-speedometer2"></i> BANG DIEU KHIEN</h4>

@* ===== HANG 1: THONG KE TIN TUC ===== *@
<p class="text-muted fw-bold mb-2"><i class="bi bi-newspaper"></i> Tin tuc &amp; Noi dung</p>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalPosts</div>
                    <div class="fs-6">Bai viet</div>
                </div>
                <i class="bi bi-file-earmark-post" style="font-size:3rem;opacity:.35"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Post" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly bai viet <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalCategories</div>
                    <div class="fs-6">Danh muc tin</div>
                </div>
                <i class="bi bi-grid-3x3-gap" style="font-size:3rem;opacity:.35"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Category" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly danh muc <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-secondary shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalUsers</div>
                    <div class="fs-6">Thanh vien QT</div>
                </div>
                <i class="bi bi-people" style="font-size:3rem;opacity:.35"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="User" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly thanh vien <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@* ===== HANG 2: THONG KE THUONG MAI ===== *@
<p class="text-muted fw-bold mb-2"><i class="bi bi-shop"></i> Thuong mai dien tu</p>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white shadow h-100" style="background:#6f42c1">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalProducts</div>
                    <div class="fs-6">San pham</div>
                </div>
                <i class="bi bi-box-seam" style="font-size:2.5rem;opacity:.35"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Product" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly san pham <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalCustomers</div>
                    <div class="fs-6">Khach hang</div>
                </div>
                <i class="bi bi-person-lines-fill" style="font-size:2.5rem;opacity:.35"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Customer" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly khach hang <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-dark shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalOrders</div>
                    <div class="fs-6">Tong don hang</div>
                </div>
                <i class="bi bi-bag-check" style="font-size:2.5rem;opacity:.35"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Order" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly don hang <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-dark bg-warning shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.PendingOrders</div>
                    <div class="fs-6">Cho duyet</div>
                </div>
                <i class="bi bi-hourglass-split" style="font-size:2.5rem;opacity:.35"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Order" asp-action="Index" class="text-dark text-decoration-none small">
                    Xem don cho duyet <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@* ===== HANG 3: BANG 2 COT ===== *@
<div class="row g-4">

    @* Cot trai: 5 bai viet moi nhat *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-clock-history text-danger"></i> 5 Bai viet moi nhat</h6>
                <a asp-controller="Post" asp-action="Create" class="btn btn-sm btn-danger">
                    <i class="bi bi-plus-circle"></i> Viet bai moi
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Tieu de</th>
                            <th style="width:120px">Danh muc</th>
                            <th style="width:90px">Ngay dang</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Post" asp-action="Details"
                                       asp-route-id="@post.Id" class="text-decoration-none">
                                        @post.Title
                                    </a>
                                </td>
                                <td><span class="badge bg-primary">@post.Category?.Name</span></td>
                                <td class="text-muted">@post.CreatedDate.ToString("dd/MM/yy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Cot phai: 5 don hang moi nhat *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-bag-check text-success"></i> 5 Don hang moi nhat</h6>
                <a asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-success">
                    Xem tat ca <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px">Ma don</th>
                            <th>Khach hang</th>
                            <th style="width:90px">Ngay dat</th>
                            <th style="width:100px" class="text-center">Trang thai</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentOrders != null)
                        {
                            foreach (var order in ViewBag.RecentOrders)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">#@order.Id</td>
                                    <td>@(order.Customer?.FullName ?? "KH #" + order.CustomerId)</td>
                                    <td class="text-muted">@order.OrderDate.ToString("dd/MM/yy")</td>
                                    <td class="text-center">
                                        @if (order.Status == 0)
                                        { <span class="badge bg-warning text-dark">Cho</span> }
                                        else if (order.Status == 1)
                                        { <span class="badge bg-info text-dark">Giao</span> }
                                        else
                                        { <span class="badge bg-success">Xong</span> }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Chua co don hang nao.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
