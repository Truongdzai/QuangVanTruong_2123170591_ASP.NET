@model IEnumerable<CMS.Data.Entities.Post>

@{ Layout = "_LayoutAdmin"; ViewData["Title"] = "Bang dieu khien"; }

<h4 class="mb-4"><i class="bi bi-speedometer2"></i> BANG DIEU KHIEN</h4>

@* ===== HANG 1: 3 THE THONG KE NHANH ===== *@
<div class="row g-4 mb-4">

    @* The 1: Tong bai viet *@
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalPosts</div>
                    <div class="fs-6">Bai viet</div>
                </div>
                <i class="bi bi-file-earmark-post" style="font-size:3rem; opacity:.4"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Post" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly bai viet <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    @* The 2: Tong danh muc *@
    <div class="col-md-4">
        <div class="card text-white bg-success shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalCategories</div>
                    <div class="fs-6">Danh muc</div>
                </div>
                <i class="bi bi-grid" style="font-size:3rem; opacity:.4"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="Category" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly danh muc <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    @* The 3: Tong thanh vien *@
    <div class="col-md-4">
        <div class="card text-white bg-secondary shadow h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="display-5 fw-bold">@ViewBag.TotalUsers</div>
                    <div class="fs-6">Thanh vien</div>
                </div>
                <i class="bi bi-people" style="font-size:3rem; opacity:.4"></i>
            </div>
            <div class="card-footer border-0 bg-transparent">
                <a asp-controller="User" asp-action="Index" class="text-white text-decoration-none small">
                    Quan ly thanh vien <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

</div>

@* ===== HANG 2: BANG 5 BAI VIET MOI NHAT ===== *@
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history text-danger"></i> 5 Bai viet moi nhat</h5>
        <a asp-controller="Post" asp-action="Create" class="btn btn-sm btn-danger">
            <i class="bi bi-plus-circle"></i> Viet bai moi
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tieu de</th>
                    <th style="width:160px">Danh muc</th>
                    <th style="width:120px">Ngay dang</th>
                    <th style="width:80px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    <tr>
                        <td>@post.Title</td>
                        <td>
                            <span class="badge bg-primary">@post.Category?.Name</span>
                        </td>
                        <td class="text-muted small">@post.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @* Nut xem nhanh chi tiet bai viet *@
                            <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
