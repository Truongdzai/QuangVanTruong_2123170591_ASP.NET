@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="text-center py-5">
    <i class="bi bi-shield-x text-danger" style="font-size: 5rem;"></i>

    <h1 class="display-6 text-danger mt-3">403 - KHÔNG CÓ QUYỀN TRUY CẬP</h1>

    <p class="lead text-muted mt-3">
        Bạn không có đủ quyền hạn để xem trang này.
    </p>
    <p class="text-muted">
        Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là nhầm lẫn.
    </p>

    <div class="mt-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-primary me-2">
            <i class="bi bi-house me-1"></i>Về trang chủ Admin
        </a>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
        </a>
    </div>
</div>
