@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Trang chu CMS";
}

<div class="text-center mb-5">
    <h1 class="display-4">CMS Full-Stack</h1>
    <p class="lead">Quang Van Truong -- MSV: 2123170591</p>
    <p class="text-muted">Bai thuc hanh 4: Admin Panel </p>
    <span class="d-flex flex-wrap gap-2 justify-content-center mt-3">
        <a asp-controller="Category" asp-action="Index" class="btn btn-primary">Danh muc tin</a>
        <a asp-controller="Post" asp-action="Index" class="btn btn-danger">Bai viet</a>
        <a asp-controller="User" asp-action="Index" class="btn btn-dark">Thanh vien</a>
    </span>
</div>

<h2 class="text-center mb-4 text-danger">TIN TUC MOI NHAT</h2>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                @* Neu ImageUrl trong hoac null -> hien anh mac dinh, onerror xu ly link chet *@
                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.svg" : item.ImageUrl)"
                     class="card-img-top" style="height:180px; object-fit:cover"
                     alt="@item.Title" onerror="this.src='/images/no-image.svg'" />
                <div class="card-body d-flex flex-column">
                    @* Badge danh muc - lay duoc nho .Include(Category) trong HomeController *@
                    <span class="badge bg-primary mb-2 align-self-start">@item.Category?.Name</span>
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text text-truncate">@item.Content</p>
                    <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-outline-danger btn-sm mt-auto">Doc tiep</a>
                </div>
                <div class="card-footer text-muted small">
                    Ngay dang: @item.CreatedDate.ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>
    }
</div>
